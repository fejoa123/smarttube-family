<?xml version="1.0" encoding="utf-8"?>
<!-- Family build: lets ProfilePickerPresenter see the official YouTube Kids app (Android 11+ package visibility) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.google.android.youtube.tvkids" />
        <package android:name="com.google.android.apps.youtube.kids" />
    </queries>
</manifest>
